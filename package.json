{
  "name": "halyra-focus",
  "productName": "Halyra Focus",
  "version": "1.5.0",
  "description": "Free app & website blocker for Mac and Windows. Focus sessions, schedules, Pomodoro, daily limits, focus sounds, a smart focus coach, an AI style studio and retro themes. Optional account sync and a web app for your phone. No tracking — and you can always turn it off.",
  "main": "src/main/main.js",
  "author": "Halyra",
  "license": "MIT",
  "homepage": "https://tibi772.github.io/halyra-focus/",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "preview:ui": "node tools/ui-preview.js preview",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "site": "node website-src/build.js"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.halyra.focus",
    "productName": "Halyra Focus",
    "copyright": "© 2026 Halyra",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!src/mobile/**"
    ],
    "afterPack": "build/adhoc-sign.js",
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "HalyraFocus-mac.${ext}",
      "minimumSystemVersion": "12.0",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Halyra Focus uses this to block websites in your browser tabs (also ones that were already open), to turn on website blocking with one admin prompt and, for daily limits, to see which website is open. Nothing leaves your computer."
      }
    },
    "dmg": {
      "title": "Halyra Focus",
      "artifactName": "HalyraFocus-mac.dmg",
      "contents": [
        {
          "x": 150,
          "y": 190
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "HalyraFocus-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Halyra Focus",
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    },
    "protocols": [
      {
        "name": "Halyra Focus",
        "schemes": [
          "halyrafocus"
        ]
      }
    ]
  }
}
